<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <include domain="database" path="news.db" />
    <include domain="sharedpref" path="." />
    <!--
      Naming includes means nothing else is backed up, so the datastore holding
      the API key is already out. An <exclude> for it would name a path that was
      never included, which lint rejects.
    -->
</full-backup-content>
