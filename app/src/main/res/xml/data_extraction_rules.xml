<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="news.db" />
        <include domain="file" path="datastore/" />
        <!-- Settings hold the API key; it stays on the device it was typed into. -->
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="news.db" />
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
